# Mobileum RenewIQ Platform - Environment Variables Example
# Copy this file to .env before starting the development server

# Supabase Database & Auth Settings (Optional for offline demo mode)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI / Custom LLM API Settings (Optional for rule-based assistant mode)
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_MODEL=gpt-4o
